# Argus local Docker profile. Copy to .env.docker; it is ignored by Git.
APP_PORT=8080

# Reproducible container version. Update deliberately after local verification.
OLLAMA_IMAGE=ollama/ollama:0.34.1

# The installer asks for API inference or local models. Local standard profile:
# about 12.5 GB of model downloads before Docker image layers.
LLM_PROVIDER=ollama
RAG_DEFAULT_ENABLED=true
OLLAMA_QUICK_MODEL=qwen3.5:4b
OLLAMA_DEEP_MODEL=qwen3.5:9b
EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_QUICK_NUM_CTX=16384
OLLAMA_DEEP_NUM_CTX=32768

PIPELINE_TIMEOUT_MS=3600000
PIPELINE_PHASE_TIMEOUT_MS=900000

# API provider credentials are requested by the launcher and stored only in
# the ignored .env.docker file. RAG embeddings still use local Ollama.
# GOOGLE_API_KEY=
# KIMI_API_KEY=
# CURSOR_API_KEY=
# BEDROCK_AWS_REGION=us-east-1
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
