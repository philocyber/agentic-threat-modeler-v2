{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs start",
    "dev:next": "next dev --webpack --hostname 127.0.0.1",
    "dev:local": "node scripts/dev.mjs start",
    "build": "node scripts/build-runtime.mjs && next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-local.mjs",
    "pipeline:worker": "tsx scripts/pipeline-worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "npx --yes knip",
    "test": "vitest run",
    "audit:hydration": "vitest run lib/ui/__tests__/hydration-safety.test.ts",
    "test:watch": "vitest",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "drizzle:check": "drizzle-kit check && drizzle-kit check --config drizzle.sqlite.config.ts",
    "db:verify:postgres": "tsx scripts/verify-postgres-schema.ts",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "rag:index": "tsx scripts/index-knowledge-base.ts",
    "test:gemini": "tsx scripts/test-gemini.ts",
    "test:kimi": "tsx scripts/test-kimi.ts",
    "test:bedrock": "tsx scripts/test-bedrock.ts",
    "test:cursor": "tsx scripts/test-cursor.ts",
    "services:up": "node scripts/dev.mjs services-up",
    "services:down": "node scripts/dev.mjs services-down",
    "package:source": "node scripts/package-source.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:tooling": "vitest run lib/tooling/__tests__",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs && pnpm drizzle:check",
    "test:standalone": "node scripts/smoke-standalone.mjs",
    "test:docker": "sh scripts/smoke-docker.sh",
    "acceptance:offline": "node scripts/acceptance-offline.mjs",
    "acceptance:local": "tsx scripts/stage2-local-acceptance.ts",
    "acceptance:kimi": "tsx scripts/stage3-kimi-acceptance.ts"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1107.0",
    "@cursor/sdk": "1.0.31",
    "@heroicons/react": "^2.2.0",
    "@huggingface/tokenizers": "0.2.0",
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.1.29",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.5.5",
    "@react-pdf/renderer": "^4.6.1",
    "better-sqlite3": "^13.0.2",
    "chromadb": "^3.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "mermaid": "11.17.2",
    "next": "16.3.4",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/nft": "1.11.0",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
