# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Next.js sets this automatically:
#   - 'development' when running `next dev`
#   - 'production' when running `next build` && `next start`
# Only override if needed (e.g., for testing production behavior locally)
# NODE_ENV="development"

# ==============================================================================
# DATABASE
# ==============================================================================
# Optional: without DATABASE_URL the app runs in local workspace mode and each
# project persists to its own SQLite database (see README → Workspaces locales).
# DATABASE_URL="postgresql://postgres:password@localhost:5432/agentic-tm"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic-tm
DB_USER=postgres
DB_PASSWORD=password

# Root folder for local project workspaces (SQLite + artifacts per project)
# AGENTICTM_WORKSPACE_ROOT="~/.agentictm/projects"

# ==============================================================================
# LLM CONFIGURATION
# ==============================================================================
# LLM Provider: 'ollama' | 'google' | 'kimi' | 'bedrock' | 'cursor'
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama models (defaults in lib/config: qwen3.5:4b quick / qwen3.5:9b deep)
# OLLAMA_MODEL="qwen3.5:9b"                 # Fallback if QUICK/DEEP unset
# OLLAMA_QUICK_MODEL="qwen3.5:4b"
# OLLAMA_DEEP_MODEL="qwen3.5:9b"

# Google Gemini (uncomment when API key available)
# GOOGLE_API_KEY=""
# GEMINI_QUICK_MODEL="gemini-3.5-flash-lite"
# GEMINI_DEEP_MODEL="gemini-3.1-pro-preview"

# Kimi / Moonshot (OpenAI-compatible) — https://platform.kimi.ai
# MOONSHOT_API_KEY=""                       # official env name
# KIMI_API_KEY=""                           # alias accepted by Argus
# KIMI_BASE_URL="https://api.moonshot.ai/v1"
# KIMI_QUICK_MODEL="kimi-k2.6"
# KIMI_DEEP_MODEL="kimi-k3"

# AWS Bedrock (Converse API via @langchain/aws)
# BEDROCK_AWS_REGION="us-east-1"
# BEDROCK_AWS_ACCESS_KEY_ID=""
# BEDROCK_AWS_SECRET_ACCESS_KEY=""
# BEDROCK_AWS_SESSION_TOKEN=""               # optional (temporary creds)
# BEDROCK_INFERENCE_PROFILE_ARN=""          # optional application inference profile
# BEDROCK_QUICK_MODEL="anthropic.claude-haiku-4-5-20251001-v1:0"
# BEDROCK_DEEP_MODEL="anthropic.claude-sonnet-5"
# # Also accepts AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Cursor SDK — Grok 4.7 (text-only Agent.prompt; not a chat-completions API)
# Create a key at https://cursor.com/dashboard/integrations
# Defaults if unset: grok-4.7 / grok-4.7 / Fast on quick. Uncomment to override.
# CURSOR_API_KEY=""
# CURSOR_QUICK_MODEL="grok-4.7"
# CURSOR_DEEP_MODEL="grok-4.7"
# CURSOR_QUICK_FAST="true"                 # false / 0 / no / off disables Fast on quick

# Output token limits (optional overrides)
# Defaults are optimized per provider:
#   - Ollama: quick=4096, deep=8192 (conservative for smaller models)
#   - Gemini/Kimi/Bedrock: quick=8192, deep=16384
# OLLAMA_QUICK_MAX_TOKENS="4096"
# OLLAMA_DEEP_MAX_TOKENS="8192"

# Ollama context window (num_ctx). If the prompt (system + architecture + RAG
# output) exceeds this, Ollama silently truncates it. Defaults: quick=16384,
# deep=32768. Lower them if you are short on VRAM.
# OLLAMA_QUICK_NUM_CTX="16384"
# OLLAMA_DEEP_NUM_CTX="32768"
# GEMINI_QUICK_MAX_TOKENS="8192"
# GEMINI_DEEP_MAX_TOKENS="16384"
# KIMI_QUICK_MAX_TOKENS="8192"
# KIMI_DEEP_MAX_TOKENS="16384"
# BEDROCK_QUICK_MAX_TOKENS="8192"
# BEDROCK_DEEP_MAX_TOKENS="16384"

# ==============================================================================
# RAG / VECTOR DATABASE
# ==============================================================================
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="qwen3-embedding:4b"
RAG_TOP_K="5"
RAG_CONFIDENCE_THRESHOLD="0.65"

# ==============================================================================
# THREAT MODELING PIPELINE
# ==============================================================================
PIPELINE_EXECUTION_MODE="hybrid"
PIPELINE_MAX_PARALLEL_ANALYSTS="2"
PIPELINE_MAX_DEBATE_ROUNDS="3"
PIPELINE_TARGET_THREATS="15"
# Single confidence gate applied once in pre-dedup to raw analyst threats.
# PIPELINE_CONFIDENCE_THRESHOLD="0.55"
# Max concurrent LLM batch calls in the DREAD validator / synthesizer (1-8).
# PIPELINE_VALIDATOR_CONCURRENCY="3"
PIPELINE_TIMEOUT_MS="3600000"              # 60 minutes for hosted reasoning/full-power runs
PIPELINE_PHASE_TIMEOUT_MS="900000"         # 15-minute per-phase cap, bounded by the global budget
ARCHITECTURE_CHUNK_CONCURRENCY="3"          # Cloud only; Ollama always stays sequential
MAX_RUN_COST_USD=""                        # Disabled when empty; cloud models require LLM_PRICES_JSON
LLM_PRICES_JSON=""                         # {"model":{"input":0.95,"output":4}} USD per 1M tokens
KNOWLEDGE_BASE_PATH="./knowledge_base"
PAGE_INDICES_PATH="./data/page_indices"
# Per-call ceiling for one structured LLM response. Defaults: 300s for Ollama and
# hosted reasoning models, 120s for the prompt fallback. Raise it if an agent
# times out on large inputs (a 21 KB architecture takes ~153s on kimi-k2.6).
# STRUCTURED_TIMEOUT_MS="300000"
# Wall-clock ceiling for one agent's retries. Stops a slow provider from spending
# the whole pipeline budget on a single phase that never succeeds.
# STRUCTURED_RETRY_BUDGET_MS="900000"
# Token counts come from the providers and are always recorded. Cost is derived
# from these rates (USD per 1M tokens); a model missing here reports tokens and
# no cost rather than a guessed figure. Copy the current rates from your
# provider's pricing page — they are not hardcoded because they go stale.
# Required before a paid Kimi acceptance call. Use only fictional input unless
# your provider agreement explicitly permits the data you intend to send.
# LLM_PRICES_JSON='{"kimi-k2.6":{"input":0.95,"output":4},"kimi-k3":{"input":3,"output":15}}'

# Unique per worker process. Required when scaling pipeline-worker: two replicas
# with the same id can renew each other's lease. Leave unset for hostname:pid:uuid.
# INSTANCE_ID="agentictm-1"

# ==============================================================================
# SERVICE AUTH (shared Postgres)
# ==============================================================================
# Required when DATABASE_URL is set, regardless of workspace cookies, if
# NODE_ENV=production or SERVICE_AUTH_REQUIRED=true. Comma-separated bearer
# tokens; each token is its own principal.
# SERVICE_AUTH_TOKENS=""
# SERVICE_AUTH_REQUIRED="true"

# Reverse-proxy hop count for rate-limit client IP. 0 ignores X-Forwarded-For
# and X-Real-IP (client-controlled). Set to 1 behind a single trusted proxy
# that overwrites X-Forwarded-For.
# TRUSTED_PROXY_HOPS="0"

# ==============================================================================
# EXTERNAL INTEGRATIONS
# ==============================================================================
# Partner platform callback base URL (optional)
# PARTNER_BASE_URL="http://localhost:3001"

# Exact hosted model context capacities verified for your deployment, in tokens.
# Verified Kimi defaults: kimi-k2.6=262144, kimi-k3=1000000.
# Other unlisted hosted models use a 32768-token fallback; large inputs require an override.
# Changing this requires restart; it invalidates resume fingerprints.
# MODEL_CONTEXT_WINDOWS='{"your-exact-model-id":131072}'
